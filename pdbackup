#!/usr/bin/env bash

# pdbackup: a Bash script for backing up a local folder to a remote Proton
# Drive folder.

set -u

# --- Configuration ---

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

# --- Helper Functions ---

die() {
  local msg="$1"
  local code="${2:-1}"
  echo "[$SCRIPT_NAME:${BASH_LINENO[0]}] ERROR: $msg" >&2
  exit "$code"
}

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$@" >&2
}

usage() {
  echo "Usage: $SCRIPT_NAME \"<local_path>\" \"<remote_path>\""
  printf "\n"
  echo "NOTE:"
  echo "  Paths with spaces in them must be quoted."
  echo "  Do not add the Proton Drive root folder (/my-files) to remote path."
  echo "  To change the target folder for the log file, edit 'LOG_TARGET'."
  printf "\n"
  echo "Options:"
  echo "  -h  Display this help text."
}

# --- Main Logic ---

readonly LOG_TARGET="$HOME"

while getopts :h opt; do
  case "$opt" in
    h)  usage
        exit 0
        ;;
    \?) die "option '-$OPTARG' not valid; use '$SCRIPT_NAME -h' for help."
        ;;
  esac
done

shift $((OPTIND - 1))

if ! command -v proton-drive > /dev/null; then
  die "proton-drive CLI not installed."
fi

if ! (($# == 2)); then
  die "wrong number of arguments; use '$SCRIPT_NAME -h' for help."
fi

if ! ip route get 1.1.1.1 || ! ping -c 1 -W 10 1.1.1.1; then
  log "Could not reach external host." >> "$LOG_TARGET/pdbackup.log" 2>&1
  die "unable to establish network connection."
fi

local_folder="${1/#\~/$HOME}"
remote_folder="/my-files/$2_$(date +"%Y-%m-%d")"

if [[ ! -d "$local_folder" ]]; then
  die "local folder $local_folder does not exist."
fi

log "Uploading files to Proton Drive..." >> "$LOG_TARGET/pdbackup.log" 2>&1

proton-drive filesystem upload --file-conflict-strategy replace \
  --folder-conflict-strategy replace "$local_folder" "$remote_folder" || \
  { log "Upload failed." >> "$LOG_TARGET/pdbackup.log" 2>&1; \
    die "unable to upload files to remote folder $remote_folder."; }

log "Upload successfully completed." >> "$LOG_TARGET/pdbackup.log" 2>&1
